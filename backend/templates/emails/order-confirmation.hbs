<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Order Confirmation</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      line-height: 1.6;
      color: #333;
      max-width: 600px;
      margin: 0 auto;
    }
    .header {
      background-color: #3B82F6;
      padding: 20px;
      text-align: center;
      color: white;
    }
    .content {
      padding: 20px;
    }
    .order-details {
      margin-top: 20px;
      border: 1px solid #ddd;
      border-radius: 5px;
      padding: 15px;
    }
    .item {
      display: flex;
      justify-content: space-between;
      padding: 10px 0;
      border-bottom: 1px solid #eee;
    }
    .item:last-child {
      border-bottom: none;
    }
    .total {
      margin-top: 15px;
      text-align: right;
      font-weight: bold;
    }
    .footer {
      text-align: center;
      margin-top: 30px;
      font-size: 12px;
      color: #777;
    }
  </style>
</head>
<body>
  <div class="header">
    <h1>Order Confirmation</h1>
  </div>
  <div class="content">
    <p>Hello {{userName}},</p>
    <p>Thank you for your order! We've received your order and will begin processing it shortly.</p>
    
    <div class="order-details">
      <h2>Order #{{orderNumber}}</h2>
      <p>Date: {{orderDate}}</p>
      
      <h3>Items:</h3>
      {{#each items}}
        <div class="item">
          <div>
            <strong>{{this.product.name}}</strong>
            <p>Quantity: {{this.quantity}}</p>
          </div>
          <div>${{this.price}}</div>
        </div>
      {{/each}}
      
      <div class="total">
        <p>Subtotal: ${{subtotal}}</p>
        <p>Tax: ${{tax}}</p>
        <p>Shipping: ${{shipping}}</p>
        <p>Total: ${{total}}</p>
      </div>
    </div>
    
    <div class="shipping">
      <h3>Shipping Address:</h3>
      <p>{{shippingAddress.name}}<br>
      {{shippingAddress.street}}<br>
      {{shippingAddress.city}}, {{shippingAddress.state}} {{shippingAddress.zip}}<br>
      {{shippingAddress.country}}</p>
    </div>
    
    <p>If you have any questions about your order, please contact our customer service.</p>
  </div>
  <div class="footer">
    <p>&copy; 2023 B2B Nexus. All rights reserved.</p>
  </div>
</body>
</html>